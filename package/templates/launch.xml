<launch>
  <arg name="{{package_name}}_param_path" default="$(find-pkg-share autoware_{{package_name}})/config/{{package_name}}.param.yaml"/>

  <node pkg="autoware_{{package_name}}" exec="autoware_{{package_name}}_node" name="autoware_{{package_name}}" output="screen">
    <param from="$(var {{package_name}}_param_path)"/>
  </node>
</launch>
